<?xml version="1.0" encoding="utf-8"?>
<!-- YAML. Colours here are placeholders; SyntaxTheme recolours by name. -->
<SyntaxDefinition name="YAML" extensions=".yml;.yaml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#008000" />
  <Color name="Identifier" foreground="#000088" fontWeight="bold" />
  <Color name="Keyword" foreground="#880088" />
  <Color name="Number" foreground="#FF0000" />
  <Color name="Reference" foreground="#008888" />
  <Color name="Document" foreground="#FFFFFF" background="#000088" />
  <Color name="String" foreground="#808080" />
  <Color name="Operator" foreground="#000000" fontWeight="bold" />

  <RuleSet>
    <Span color="Comment">
      <Begin>(?&lt;!\S)\#</Begin>
    </Span>

    <Rule color="Document">^(---|\.\.\.)(?=\s|$)</Rule>

    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
    </Span>

    <Rule color="Identifier">(?&lt;=^\s*(-\s+)?)[^\s\#:'"\-][^\#:]*?(?=:(\s|$))</Rule>
    <Rule color="Reference">[&amp;*][\w.-]+</Rule>

    <Keywords color="Keyword">
      <Word>true</Word><Word>false</Word><Word>null</Word><Word>yes</Word><Word>no</Word><Word>on</Word><Word>off</Word>
      <Word>True</Word><Word>False</Word><Word>Null</Word><Word>TRUE</Word><Word>FALSE</Word><Word>NULL</Word>
    </Keywords>

    <Rule color="Keyword">(?&lt;=:\s+)~(?=\s|$)</Rule>
    <Rule color="Number">(?&lt;![\w.])-?[0-9]+(\.[0-9]+)?(?![\w.])</Rule>
    <Rule color="Operator">:(?=\s|$)|(?&lt;=^\s*)-(?=\s)|[{}\[\],]</Rule>
  </RuleSet>
</SyntaxDefinition>
